# ---- Core ----
ENVIRONMENT=development                # development | production
# PostgreSQL in production (Neon / Supabase / RDS / Render). SQLite is used if unset.
DATABASE_URL=postgresql://applypilot:password@localhost:5432/applypilot
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=720
# Fernet key for encrypting profile data and resume files at rest:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ---- Storage ----
STORAGE_DIR=./storage                  # mount a persistent private volume here in production
MAX_UPLOAD_MB=10

# ---- AI (Anthropic Claude) ----
# Leave empty to run in heuristic mode (no AI calls).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium                       # low | medium | high | xhigh | max
AI_ENABLE_FALLBACKS=true               # server-side refusal fallbacks

# ---- Browser automation ----
AUTOMATION_HEADLESS=true               # false = visible browser window (local use on your laptop)
PLAYWRIGHT_CHROMIUM_EXECUTABLE=        # optional explicit Chromium path
AUTOMATION_TIMEOUT_MS=20000
AUTOMATION_MAX_PAGES=12
AUTOMATION_MAX_SESSIONS=3

# ---- Local testing only ----
ALLOW_PRIVATE_URLS=false               # true lets job URLs point at localhost (fixture portal)
